# Copie este arquivo para .env e preencha.

# Token criado no @BotFather (obrigatório)
TELEGRAM_BOT_TOKEN=

# URL do backend do InstaView
API_URL=http://localhost:3000

# Canal de divulgação (@username do canal ou id -100...)
TELEGRAM_CHANNEL_ID=

# Seu id do Telegram (veja em @userinfobot) — libera o /canal
ADMIN_ID=
