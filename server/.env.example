# Copie este arquivo para .env e preencha.
# O cookie sessionid é o que desbloqueia as consultas reais.

# 1. Faça login no Instagram no navegador
# 2. F12 → Application → Cookies → https://www.instagram.com
# 3. Copie o valor do cookie "sessionid" e cole abaixo (SEM aspas)
IG_SESSIONID=

# Porta do servidor (opcional)
PORT=3000
